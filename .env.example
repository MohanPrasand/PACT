# PACT environment template — copy to .env and fill in.

# --- PayPal Sandbox (https://developer.paypal.com/dashboard/applications/sandbox) ---
# Paste your Sandbox app credentials below.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_TIMEOUT_SECONDS=15

# Switch to "paypal" once the credentials above are filled in.
PACT_PAYMENT_PROVIDER=simulation

# --- PACT core ---
PACT_DATABASE_URL=sqlite:///./pact.db
# Dashboard/approval token (generated locally). Agents never receive this. Required, at least 16 characters,
# not a placeholder. Generate one:  python -c "import secrets; print(secrets.token_urlsafe(32))"
PACT_ADMIN_TOKEN=
# PayPal supports INR only for in-country India accounts; USD works for any sandbox account.
PACT_CURRENCY=USD
PACT_PUBLIC_URL=http://localhost:8000
PACT_GRANT_TTL_SECONDS=600
PACT_APPROVAL_TTL_SECONDS=1800
PACT_EXPIRY_SWEEP_SECONDS=15
